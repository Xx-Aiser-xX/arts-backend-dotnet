# 1. ДЛЯ DOCKER-COMPOSE (при запуске в контейнерах)
DB_PORT=5432
DB_NAME=arts
DB_USER=postgres
DB_PASSWORD=your_postgres_password

KC_DB_NAME=keycloak_db
KC_DB_USER=keycloak_user
KC_DB_PASSWORD=your_keycloak_db_password

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your_keycloak_admin_password
KEYCLOAK_PORT=8080

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=arts-photo
MINIO_DATA_PATH=./minio_data

REDIS_PORT=6379
TAGGER_URL=https://example.org

# 2. ДЛЯ RIDER / VISUAL STUDIO (при локальном запуске бэкенда на ПК)
ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=arts;Username=postgres;Password=your_postgres_password"
ConnectionStrings__Redis="localhost:6379"

Minio__EndpointUrl="http://127.0.0.1:9000"
Minio__BucketName="arts-photo"
Minio__AccessKey="minioadmin"
Minio__SecretKey="your_minio_password"

Keycloak__BaseUrl="http://localhost:8080"
Keycloak__Realm="arts-realm"
Keycloak__AdminUsername="admin"
Keycloak__AdminPassword="your_keycloak_admin_password"

Tagger__BaseUrl="https://example.org"