{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "AllowedHosts": "*",

  "CacheSettings": {
    "DefaultTtlMinutes": 10,
    "Policies": {
      "Arts": 120,
      "Comments": 30,
      "Search": 15,
      "AuthorsArts": 30,
      "Tags": 120,
      "SocialNetworks": 60,
      "User": 120
    }
  }
}